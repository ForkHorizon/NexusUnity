{
  "version": 1,
  "checks": [
    {
      "id": "code-linter",
      "type": "code-linter",
      "config": ".code-linter.json",
      "params": {"mode": "auto"},
      "events": ["pull_request"]
    },
    {
      "id": "python-quality",
      "type": "python-quality",
      "events": ["pull_request"]
    },
    {
      "id": "python-tests",
      "type": "python-tests",
      "workdir": "Editor",
      "events": ["pull_request"]
    },
    {
      "id": "unity-quality",
      "type": "unity-quality",
      "events": ["pull_request"]
    }
  ]
}
